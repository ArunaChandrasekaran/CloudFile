<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefWidth="1920.0" prefHeight="1080.0"
           minWidth="1024.0" minHeight="640.0"
           stylesheets="@../Login/style.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Onboarding.OnboardingController"
           fx:id="rootPane" styleClass="login-root" maxWidth="Infinity" maxHeight="Infinity">

    <VBox alignment="CENTER" maxWidth="Infinity" maxHeight="Infinity" spacing="0">
        <padding>
            <Insets top="48" right="64" bottom="40" left="64"/>
        </padding>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox styleClass="login-card" alignment="TOP_CENTER" spacing="18"
              prefWidth="480" maxWidth="480" minWidth="360">
            <VBox alignment="CENTER" spacing="10">
                <ImageView styleClass="login-user-avatar"
                           fitWidth="72" fitHeight="72"
                           preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../Assets/Images/login-user-avatar.png"/>
                    </image>
                </ImageView>
                <Label fx:id="titleLabel" text="SET UP YOUR COMPANY" styleClass="welcome-title"/>
                <Label fx:id="hintLabel" text="Step 1 of 2 — Company details"
                       styleClass="welcome-hint"/>
            </VBox>

            <!-- Step 1: Company -->
            <VBox fx:id="companyStep" spacing="12" maxWidth="Infinity">
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="COMPANY NAME" styleClass="input-label"/>
                    <TextField fx:id="companyNameField" promptText="Enter company name"
                               styleClass="custom-textfield" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="COMPANY ADDRESS" styleClass="input-label"/>
                    <TextArea fx:id="companyAddressField" promptText="Enter company address"
                              styleClass="custom-textarea" wrapText="true"
                              prefRowCount="3" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- Step 2: Super Admin -->
            <VBox fx:id="adminStep" spacing="12" maxWidth="Infinity"
                  visible="false" managed="false">
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="FULL NAME" styleClass="input-label"/>
                    <TextField fx:id="adminNameField" promptText="Enter super admin name"
                               styleClass="custom-textfield" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="PHONE" styleClass="input-label"/>
                    <TextField fx:id="adminPhoneField" promptText="Enter phone number"
                               styleClass="custom-textfield" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="EMAIL" styleClass="input-label"/>
                    <TextField fx:id="adminEmailField" promptText="Enter email address"
                               styleClass="custom-textfield" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="ADDRESS" styleClass="input-label"/>
                    <TextArea fx:id="adminAddressField" promptText="Enter address"
                              styleClass="custom-textarea" wrapText="true"
                              prefRowCount="2" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="USERNAME" styleClass="input-label"/>
                    <TextField fx:id="usernameField" promptText="Choose a username"
                               styleClass="custom-textfield" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="PASSWORD" styleClass="input-label"/>
                    <PasswordField fx:id="passwordField" promptText="Choose a password"
                                   styleClass="custom-textfield" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" maxWidth="Infinity">
                    <Label text="FORGOT PASSWORD PHRASE" styleClass="input-label"/>
                    <TextField fx:id="forgotPhraseField" promptText="Phrase to recover password"
                               styleClass="custom-textfield" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox spacing="14" alignment="CENTER" maxWidth="Infinity">
                <Button fx:id="primaryBtn" text="Next" styleClass="login-btn"
                        maxWidth="Infinity" mnemonicParsing="false"
                        onAction="#onPrimaryAction"/>
                <Button fx:id="backBtn" text="Back" styleClass="signup-link"
                        maxWidth="Infinity" mnemonicParsing="false"
                        visible="false" managed="false"
                        onAction="#onBack"/>
            </VBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="8" styleClass="thalam-brand-lockup footer-brand-block">
            <ImageView fitWidth="56" fitHeight="56" preserveRatio="true" smooth="true"
                       styleClass="thalam-brand-logo">
                <image>
                    <Image url="@../Assets/Images/thalam-logo.png"/>
                </image>
            </ImageView>
            <VBox styleClass="thalam-brand-copy">
                <Label text="THALAM" styleClass="thalam-brand-title"/>
                <Label text="The Builder's Foundation" styleClass="thalam-brand-tagline"/>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
