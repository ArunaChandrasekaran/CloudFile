<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox prefWidth="520.0" prefHeight="420.0"
      minWidth="480.0" minHeight="380.0"
      maxWidth="560.0" maxHeight="480.0"
      styleClass="material-popup"
      stylesheets="@AddMaterialPopup.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Materials.AddMaterialPopupController">

    <VBox styleClass="material-popup-header" spacing="4">
        <Label text="Add Material" styleClass="material-popup-title"/>
        <Label text="Add a new material and fill in the details." styleClass="material-popup-tagline"/>
    </VBox>

    <VBox styleClass="material-popup-body" spacing="18" VBox.vgrow="ALWAYS"
          maxWidth="Infinity">
        <GridPane styleClass="module-form-grid" hgap="16" vgap="16" maxWidth="Infinity">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>

            <VBox styleClass="module-form-field-block" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <HBox spacing="0">
                    <Label text="Material Name " styleClass="module-form-label"/>
                    <Label text="*" styleClass="module-form-required"/>
                </HBox>
                <TextField fx:id="materialNameField" styleClass="module-form-input"
                           promptText="Enter material name"/>
            </VBox>

            <VBox styleClass="module-form-field-block" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <HBox spacing="0">
                    <Label text="Unit " styleClass="module-form-label"/>
                    <Label text="*" styleClass="module-form-required"/>
                </HBox>
                <ComboBox fx:id="unitCombo" styleClass="module-form-combo"
                          promptText="Select unit" maxWidth="Infinity">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Bag (Bag)"/>
                            <String fx:value="Kilogram (Kg)"/>
                            <String fx:value="Tonne (Ton)"/>
                            <String fx:value="Numbers (Nos)"/>
                            <String fx:value="Cubic metre (Cum)"/>
                            <String fx:value="Square metre (Sqm)"/>
                            <String fx:value="Litre (L)"/>
                            <String fx:value="Metre (m)"/>
                            <String fx:value="Feet (ft)"/>
                            <String fx:value="Bundle (Bdl)"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
        </GridPane>

        <VBox styleClass="module-form-field-block" maxWidth="Infinity">
            <Label text="Notes" styleClass="module-form-label"/>
            <TextArea fx:id="notesField" styleClass="text-area module-form-textarea module-form-notes"
                      wrapText="true" promptText="Enter notes"/>
        </VBox>
    </VBox>

    <BorderPane styleClass="material-popup-footer" maxWidth="Infinity">
        <left>
            <Button text="Cancel" styleClass="module-form-btn-cancel"
                    mnemonicParsing="false" onAction="#onCancel"/>
        </left>
        <right>
            <Button text="Save" styleClass="module-form-btn-save"
                    mnemonicParsing="false" onAction="#onSave"/>
        </right>
    </BorderPane>
</VBox>
