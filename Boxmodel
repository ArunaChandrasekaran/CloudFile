<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Box Model</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f5f5f5;
        }

        .box {
            width: 300px;              /* Content */
            padding: 30px;             /* Padding */
            border: 5px solid #ff69b4; /* Border */
            margin: 50px auto;         /* Margin */
            background-color: #ffe4ec;
        }

        .box h2 {
            margin: 0;
        }
    </style>
</head>

<body>

    <h1>CSS Box Model</h1>

    <div class="box">
        <h2>My Box</h2>
        <p>This box demonstrates the CSS Box Model.</p>
    </div>

</body>
</html>
